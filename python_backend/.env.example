# Copia este archivo a .env y configura las credenciales de Supabase PostgreSQL.
# Para un backend en Render/otra nube IPv4 usa el Supavisor Session Pooler:
# DB_HOST=aws-0-REGION.pooler.supabase.com
# DB_USER=postgres.PROJECT_REF
# DB_PORT=5432
# Obtén estos valores exactos en Supabase: Connect -> Session pooler.
DB_HOST=db.tu-project-ref.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_SSLMODE=require

# Supabase Storage (solo en el backend; nunca en Flutter)
# Crea un bucket público llamado product-images y configura estos secretos.
# SUPABASE_URL=https://tu-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
# SUPABASE_STORAGE_BUCKET=product-images

# --- Servidor API (Host/Port) ---
# API_HOST=0.0.0.0  escucha en la red local (permite conectar celulares)
API_HOST=0.0.0.0
API_PORT=8000
